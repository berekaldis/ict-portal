<IfModule mod_rewrite.c>
    RewriteEngine On

    # Protect sensitive files and directories
    RewriteRule ^(\.env|composer\.json|composer\.lock|package\.json|package-lock\.json|vite\.config\.ts)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)/ - [F,L]

    # Route all requests through the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
